{
    "name": "yorche3/php-naive-sort",
    "description": "Módulo naive_sort de la especificación 05_Naive_Sort en PHP, con PHPUnit.",
    "type": "library",
    "license": "MIT",
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "test/"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
